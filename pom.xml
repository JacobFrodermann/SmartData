<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.smartdata</groupId>
    <artifactId>SmartData</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>SmartData</name>
    <description>REST API for accessing databases over Java application servers. Implements TreeQL.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!--
        The Smart* helper libraries (NGI_Logger, NGI_RestUtils,
        NGI_AdvancedReflection and SmartUserAuth) are not published to Maven
        Central. They are kept in a small file based Maven repository inside
        this project so the build is self contained.

        The old NetBeans build referenced them as sibling Ant projects via
        project.NGI_Logger=../NGI_Logger and ${project.NGI_Logger}/dist/*.jar.
    -->
    <repositories>
        <repository>
            <id>smartdata-local</id>
            <url>file://${project.basedir}/libs/maven-repo</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Provided by the Jakarta EE application server (Payara). -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Smart* helper libraries. -->
        <dependency>
            <groupId>de.fhbielefeld.scl</groupId>
            <artifactId>NGI_Logger</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>de.fhbielefeld.scl</groupId>
            <artifactId>NGI_RestUtils</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>de.fhbielefeld.scl</groupId>
            <artifactId>NGI_AdvancedReflection</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>de.fhbielefeld.smartuser</groupId>
            <artifactId>SmartUserAuth</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Third party libraries, formerly the jars in libs/. -->
        <dependency>
            <groupId>org.eclipse.microprofile.openapi</groupId>
            <artifactId>microprofile-openapi-api</artifactId>
            <version>3.1</version>
        </dependency>
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
            <version>4.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>4.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240205</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>SmartData</finalName>

        <!-- The NetBeans/Ant layout is kept: sources in src/java, doc base in web/. -->
        <sourceDirectory>src/java</sourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <warSourceDirectory>web</warSourceDirectory>
                    <!-- The application uses Servlet 3+ annotations, no web.xml is required. -->
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
